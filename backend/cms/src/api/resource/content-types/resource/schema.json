{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "Book",
    "description": "Books listed under Research > Resources. Every book is emailed as a PDF. Free books go to anyone; paid books link out to buyUrl and are free for paid Substack subscribers, so upload the PDF on paid books too."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "access": {
      "type": "enumeration",
      "enum": [
        "free",
        "paid"
      ],
      "default": "free",
      "required": true
    },
    "price": {
      "type": "string"
    },
    "buyUrl": {
      "type": "string"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ],
      "private": true
    },
    "coverPage": {
      "type": "integer",
      "default": 1,
      "min": 1
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "autoCoverId": {
      "type": "integer",
      "private": true,
      "visible": false
    },
    "autoCoverKey": {
      "type": "string",
      "private": true,
      "visible": false
    }
  }
}
